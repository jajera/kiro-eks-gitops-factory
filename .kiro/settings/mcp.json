{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp>=1.1.3,<2",
        "mcp-server-fetch==2026.7.10"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "fetch"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp>=1.1.3,<2",
        "mcp-server-git",
        "--repository",
        "."
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "git_status"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "disabled": false,
      "autoApprove": []
    },
    "aws-knowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws",
      "disabled": false,
      "autoApprove": [
        "search_documentation",
        "read_documentation",
        "list_regions",
        "get_regional_availability"
      ]
    }
  }
}