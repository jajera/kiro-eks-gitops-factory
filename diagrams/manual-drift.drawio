        <mxCell id="c2" value="&lt;div style=&quot;text-align:left;padding:4px 2px&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;🏷 Naming&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6A7E&quot;&gt;collisions&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6A7E&quot;&gt;Same namespace or app label twice&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#879596&quot;&gt;No convention held&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#FF9900;strokeWidth=2;arcSize=12;verticalAlign=top;spacing=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="236" y="16" width="206" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="c3" value="&lt;div style=&quot;text-align:left;padding:4px 2px&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;⛔ Policy gaps&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6A7E&quot;&gt;slip through&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6A7E&quot;&gt;Missing PDB  |  runAsRoot: true&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#879596&quot;&gt;Nothing blocked it&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#D13212;strokeWidth=2;arcSize=12;verticalAlign=top;spacing=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="456" y="16" width="206" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="c4" value="&lt;div style=&quot;text-align:left;padding:4px 2px&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;✦ Prompt drift&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6A7E&quot;&gt;each session&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6A7E&quot;&gt;Unconstrained model invents a new layout&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#879596&quot;&gt;Plausible != consistent&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7D3AC1;strokeWidth=2;arcSize=12;verticalAlign=top;spacing=10;fontColor=#232F3E;" vertex="1" parent="1">
