        <mxCell id="c1" value="&lt;div style=&quot;text-align:left;padding:4px 2px&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;📁 Tree shape&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6A7E&quot;&gt;diverges&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5A6A7E&quot;&gt;deploy/  |  k8s/envs/  |  flat root&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#879596&quot;&gt;Cannot pattern-match&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#147EBA;strokeWidth=2;arcSize=12;verticalAlign=top;spacing=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="16" y="16" width="206" height="140" as="geometry"/>
