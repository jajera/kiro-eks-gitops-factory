        <mxCell id="note" value="Small differences compound into a different shape in every directory" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#5A6A7E;fontStyle=2;" vertex="1" parent="1">
