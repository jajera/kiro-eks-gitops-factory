  <diagram id="manual-drift" name="Manual Drift">
    <mxGraphModel dx="1000" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
